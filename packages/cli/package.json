{
  "name": "@atombase/cli",
  "version": "0.1.0",
  "description": "CLI for Atombase project, definition, and database management",
  "type": "module",
  "bin": {
    "atombase": "./bin/atombase.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@atombase/definitions": "workspace:*",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "jiti": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "atombase",
    "cli",
    "schema",
    "database"
  ],
  "license": "MIT"
}
