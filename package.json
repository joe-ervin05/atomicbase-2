{
  "name": "atombase",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "test:contract:sdk": "pnpm --filter @atombase/sdk test:contract",
    "build:sdk": "pnpm --filter @atombase/sdk build",
    "build:definitions": "pnpm --filter @atombase/definitions build",
    "build:cli": "pnpm --filter @atombase/cli build",
    "build:react-todo": "pnpm --filter @atombase/sdk build && pnpm --filter @atombase/definitions build && pnpm --filter react-todo build",
    "dev:sdk": "pnpm --filter @atombase/sdk dev",
    "dev:react-todo": "pnpm --filter react-todo dev"
  }
}
